# syntax=docker/dockerfile:1.7
FROM node:22.23.4-bookworm-slim AS build
WORKDIR /srv/frontend
RUN npm install --global npm@11.21.1
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/src src
COPY frontend/public public
COPY frontend/index.html frontend/tsconfig*.json frontend/vite.config.ts ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm exec -- tsc -p tsconfig.app.json && npm exec -- vite build

FROM nginx:1.30.5-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
ARG RELEASE_VERSION=unversioned
ARG SOURCE_VERSION=unknown
LABEL org.opencontainers.image.title="AI Multimodal Image Search Static Web" \
      org.opencontainers.image.version=$RELEASE_VERSION \
      org.opencontainers.image.revision=$SOURCE_VERSION
COPY --from=build /srv/frontend/dist /usr/share/nginx/html
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/nginx/routes.conf /etc/nginx/routes.conf
COPY infra/nginx/http.conf /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080 8443
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
