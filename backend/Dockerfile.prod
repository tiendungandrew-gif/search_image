# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.13.7 AS uv
FROM python:3.12.12-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /srv
ARG INSTALL_ML=true
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY backend/pyproject.toml backend/uv.lock backend/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INSTALL_ML" = true ]; then uv sync --project backend --frozen --no-dev --extra ml --no-install-project --no-managed-python; else uv sync --project backend --frozen --no-dev --no-install-project --no-managed-python; fi
COPY backend/app backend/app
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INSTALL_ML" = true ]; then uv sync --project backend --frozen --no-dev --extra ml --no-managed-python; else uv sync --project backend --frozen --no-dev --no-managed-python; fi

FROM python:3.12.12-slim-bookworm AS runtime
ARG RELEASE_VERSION=unversioned
ARG SOURCE_VERSION=unknown
LABEL org.opencontainers.image.title="AI Multimodal Image Search API/Worker" \
      org.opencontainers.image.version=$RELEASE_VERSION \
      org.opencontainers.image.revision=$SOURCE_VERSION
ENV PATH="/srv/backend/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 HOME=/tmp HF_HOME=/tmp/huggingface
WORKDIR /srv
RUN groupadd --gid 10001 appuser && useradd --uid 10001 --gid 10001 --no-create-home appuser
COPY --from=builder /srv/backend/.venv backend/.venv
COPY backend/app backend/app
COPY backend/alembic backend/alembic
COPY backend/alembic.ini backend/alembic.ini
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-server-header", "--proxy-headers", "--forwarded-allow-ips", "*"]
