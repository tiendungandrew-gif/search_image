APP_NAME=image-search-api
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Dùng scripts/init_env.py để sinh secrets local, không dùng giá trị ví dụ làm password.
POSTGRES_DB=image_search
POSTGRES_USER=image_search
POSTGRES_PASSWORD=
DATABASE_URL=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=image-search
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true
API_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=2
DEPENDENCY_TIMEOUT_SECONDS=0.75
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=0.5
# /api là same-origin path, không chứa token hoặc internal service hostname.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://backend:8000

# Prompt 04: read token không cấp quyền ghi; generate write token riêng, >=24 chars.
WRITE_API_TOKEN=
INGESTION_INDEX_ID=
EMBEDDING_MODEL_ID=openai/clip-vit-base-patch32
EMBEDDING_MODEL_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
EMBEDDING_CACHE_DIR=/models/clip
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=4
EMBEDDING_CPU_THREADS=4
IMAGE_MAX_UPLOAD_MB=20
IMAGE_MAX_PIXELS=25000000
IMAGE_MAX_SIDE=10000
IMAGE_DECODE_TIMEOUT_SECONDS=2
INGESTION_TIMEOUT_SECONDS=30
INDEXING_MAX_RETRIES=3
INDEXING_LEASE_SECONDS=120
INDEXING_JOB_TIMEOUT_SECONDS=600
DATASET_ROOT=/datasets

# Prompt 05: activate index bằng CLI trước khi bật, không tự chọn collection.
SEARCH_ENABLED=false
SEARCH_MAX_TOP_K=50
SEARCH_DEFAULT_CANDIDATES=50
SEARCH_MAX_TEXT_LENGTH=2000
SEARCH_ENABLE_BASIC_FILTERS=true
SEARCH_QUEUE_CAPACITY=8
SEARCH_QUEUE_WAIT_SECONDS=0.05
SEARCH_VECTOR_TIMEOUT_SECONDS=1

# Prompt06: advanced paths có giới hạn; single-vector path vẫn giữ baseline.
MULTI_INTENT_ENABLED=true
MULTIMODAL_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true
SEARCH_MAX_CONSTRAINTS=8
SEARCH_MAX_BRANCHES=4
SEARCH_ADVANCED_CANDIDATE_LIMIT=100
MULTIMODAL_FUSION_STRATEGY=rrf
MULTIMODAL_TEXT_WEIGHT=0.5
MULTIMODAL_IMAGE_WEIGHT=0.5
FUSION_RRF_K=60
RERANKING_ENABLED=true
RERANKING_MAX_CANDIDATES=50
RERANKING_TIMEOUT_MS=200
RERANK_WHOLE_WEIGHT=0.4
RERANK_CONSTRAINT_WEIGHT=0.4
RERANK_METADATA_WEIGHT=0.2
RERANK_UNKNOWN_PENALTY=0.02
RERANK_REQUIRED_PENALTY=0.25
RERANK_OPTIONAL_WEIGHT=0.1

# Measured ABBA: width 2 did not improve full latency; keep width 1.
SEARCH_OBJECT_CHECK_CONCURRENCY=1

# Optional RAG: Gemini/OpenAI/self-hosted Chat Completions; key stays in backend.
RAG_ENABLED=false
RAG_MODEL_PROVIDER=gemini
RAG_MODEL_ID=gemini-3.5-flash-lite
RAG_MODEL_REVISION=provider_managed
RAG_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
RAG_GEMINI_API_STYLE=native
RAG_API_KEY=
RAG_MAX_EVIDENCE_ITEMS=5
RAG_MAX_CONTEXT_TOKENS=2048
RAG_MAX_INPUT_TOKENS=4096
RAG_MAX_OUTPUT_TOKENS=128
RAG_TEMPERATURE=0.1
RAG_TIMEOUT_SECONDS=5
RAG_REQUEST_TIMEOUT_SECONDS=8
RAG_MAX_CONCURRENCY=2
RAG_PROVIDER_RETRIES=0
RAG_STREAMING_ENABLED=true
RAG_TOKEN_PARAMETER=max_tokens
RAG_REASONING_EFFORT=minimal
